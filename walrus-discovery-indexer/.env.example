# Required: Network (testnet, mainnet or localnet)
NETWORK=testnet

# Optional: Walrus publisher's Sui address (tier 1 sender filter)
# Reduces noise by skipping BlobCertified events from other publishers.
# Without this, the indexer inspects all certified blobs.
# Leave empty / commented out rather than the 0x... placeholder.
# WALRUS_PUBLISHER_SUI_ADDRESS=

# Optional: REST API port (default: 3001)
PORT=3001

# Localnet (all three required when NETWORK=localnet; extracted automatically
# by chat-app/scripts/local-indexer.sh from a running devstack stack):
# SUI_GRPC_URL=http://127.0.0.1:51000
# WALRUS_PACKAGE_ID=0x...
# WALRUS_AGGREGATOR_URL=http://walrus-aggregator.chat-app-local.chat-app.localhost:9185
